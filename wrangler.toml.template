name = "gst-billing"
main = "worker.js"
compatibility_date = "2026-06-09"
compatibility_flags = [ "nodejs_compat", "enable_nodejs_http_server_modules" ]

[vars]
# Replace with your actual Neon / PostgreSQL connection string
DATABASE_URL = "postgresql://username:password@your-neon-host/neondb?sslmode=require"
PORT = "3000"

[assets]
directory = "./public"
[alias]
"iconv-lite" = "./polyfills/iconv-lite.js"
